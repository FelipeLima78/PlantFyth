<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#103217"
    tools:context=".TelaCadastro">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/cadastroHeaderGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.4" />

    <ImageView
        android:id="@+id/cadastroBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription=""
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cadastroHeaderGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnVoltarLogin"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_login_brand_chip"
        android:contentDescription="Voltar para a tela de login"
        android:onClick="voltarParaLogin"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_login_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/cadastroFormScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_login_panel"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="@id/cadastroHeaderGuide"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Crie sua conta 🌿"
                android:textColor="#214F2A"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Comece a cultivar e cuide das suas\nplantas com carinho."
                android:textColor="#66836A"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_login_user" />

                <EditText
                    android:id="@+id/edtCadastroUsuario"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:autofillHints="username"
                    android:background="@android:color/transparent"
                    android:hint="Digite o seu usuário"
                    android:inputType="textPersonName"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#294E2E"
                    android:textColorHint="#8AA58D"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_login_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_login_email" />

                <EditText
                    android:id="@+id/edtCadastroEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:autofillHints="emailAddress"
                    android:background="@android:color/transparent"
                    android:hint="Digite o seu email"
                    android:inputType="textEmailAddress"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#294E2E"
                    android:textColorHint="#8AA58D"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_login_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_login_lock" />

                <EditText
                    android:id="@+id/edtCadastroSenha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@android:color/transparent"
                    android:hint="Digite a sua senha"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#294E2E"
                    android:textColorHint="#8AA58D"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnMostrarSenha"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mostrar senha"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_login_eye_off" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_login_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_login_lock" />

                <EditText
                    android:id="@+id/edtConfirmeSenha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@android:color/transparent"
                    android:hint="Confirme a sua senha"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="#294E2E"
                    android:textColorHint="#8AA58D"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnMostrarConfirmacao"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mostrar senha de confirmação"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_login_eye_off" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCadastro"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:radius="12dp"
                android:shape="rectangle"
                android:backgroundTint="#2D8038"
                android:elevation="3dp"
                android:onClick="Cadastrar"
                android:text="Cadastrar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/txtEntrarCadastro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:onClick="voltarParaLogin"
                android:padding="3dp"
                android:text="Já tem uma conta? Entrar"
                android:textColor="#66836A"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
