<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastrar Planta"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginBottom="20dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Nome -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome da Planta"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/edtNomePlanta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: Rosa do Jardim"
                    android:inputType="textCapWords"/>

                <!-- Espécime -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Espécime"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

                <Spinner
                    android:id="@+id/spinnerEspecime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- Data do Plantio -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data do Plantio"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

                <EditText
                    android:id="@+id/edtDataPlantio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:hint="ddMMaaaa"
                    android:inputType="number"
                    android:maxLength="10"
                    android:onClick="AbrirCalendario" />

                <!-- Plantada como -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plantada como"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Opcional"
                        android:textSize="12sp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/radioPlantadaComo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbSemente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semente"/>

                    <RadioButton
                        android:id="@+id/rbMuda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Muda"
                        android:layout_marginStart="8dp"/>

                    <RadioButton
                        android:id="@+id/rbEstaca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estaca"
                        android:layout_marginStart="8dp"/>

                </RadioGroup>

                <!-- Tamanho atual -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tamanho Atual (cm)"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Opcional"
                        android:textSize="12sp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <EditText
                    android:id="@+id/edtTamanhoAtual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: 12.5"
                    android:inputType="numberDecimal"/>

                <!-- Foi regado hoje -->
                <CheckBox
                    android:id="@+id/checkFoiRegadoHoje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foi regado hoje?"
                    android:textStyle="bold"
                    android:layout_marginTop="18dp"
                    android:buttonTint="#2E7D32"/>

                <!-- Salvar -->
                <Button
                    android:id="@+id/btnSalvarPlanta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#2E7D32"
                    android:onClick="CadastrarPlanta"
                    android:text="Salvar Planta"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>