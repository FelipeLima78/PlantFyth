<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F3"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER VERDE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2E7D32"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar Planta"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"/>
        </LinearLayout>

        <!-- CARD DA IMAGEM -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="20dp">

            <ImageView
                android:id="@+id/imgPlanta"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/baseline_calendar_month_24" />
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD CAMPOS EDITÁVEIS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            android:padding="20dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Campos editáveis -->
                <TextView android:text="Nome da Planta:" style="@style/EditLabel" />

                <EditText
                    android:id="@+id/editNomePlanta"
                    style="@style/EditField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/EditLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Espécie:" />
                <EditText
                    android:id="@+id/editNomeEspecie"
                    style="@style/EditField" />

                <TextView android:text="Família:" style="@style/EditLabel" />
                <EditText
                    android:id="@+id/editNomeFamilia"
                    style="@style/EditField" />

                <TextView android:text="Data do Plantio:" style="@style/EditLabel" />
                <EditText
                    android:id="@+id/editDataPlantio"
                    style="@style/EditField" />

                <TextView android:text="Plantada como:" style="@style/EditLabel" />
                <EditText
                    android:id="@+id/editModoPlantio"
                    style="@style/EditField" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CARD DADOS AUTOMÁTICOS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:backgroundTint="#E8F5E9"
            android:padding="20dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Informações da Espécie"
                    android:textColor="#1B5E20"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView android:text="Irrigação:" style="@style/InfoLabel" />
                <TextView android:id="@+id/txtIrrigacaoInfo" style="@style/InfoValue" />

                <TextView android:text="Adubação:" style="@style/InfoLabel" />
                <TextView android:id="@+id/txtAdubacaoInfo" style="@style/InfoValue" />

                <TextView android:text="Umidade:" style="@style/InfoLabel" />
                <TextView android:id="@+id/txtUmidadeInfo" style="@style/InfoValue" />

                <TextView android:text="Crescimento:" style="@style/InfoLabel" />
                <TextView android:id="@+id/txtTamanhoPrevistoInfo" style="@style/InfoValue" />

                <TextView android:text="Vaso Mínimo:" style="@style/InfoLabel" />
                <TextView android:id="@+id/txtTamanhoVasoInfo" style="@style/InfoValue" />

                <TextView android:text="Observações:" style="@style/InfoLabel" />
                <TextView android:id="@+id/txtObservacoesInfo" style="@style/InfoValue" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>