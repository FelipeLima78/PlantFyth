<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_home.xml
    Layout da HomeFragment.
    IDs obrigatórios que o HomeFragment.java referencia:
      recyclerPlantasHome
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F4F0">

    <!-- ══════════════════════════════════════════════════════════
         SCROLL PRINCIPAL
    ═══════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HEADER VERDE ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2E7D32"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PlantFyth"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monitoramento diário"
                    android:textColor="#A5D6A7"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <!-- ── CARD DE AVISOS (fixo, acima da lista) ────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvisos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:backgroundTint="#FFF8E1">

                <!-- visibilidade gerenciada pelo Fragment:
                     gone quando não há plantas atrasadas,
                     visible quando há pelo menos uma -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="⚠️"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/txtAviso"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Algumas plantas precisam de atenção!"
                        android:textColor="#5D4037"
                        android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── TÍTULO DA SEÇÃO ───────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suas Plantas"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <!-- ── ESTADO VAZIO (mostrado quando não há plantas) ─── -->
            <LinearLayout
                android:id="@+id/layoutVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱"
                    android:textSize="52sp"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhuma planta cadastrada"
                    android:textColor="#424242"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toque no + para adicionar sua primeira planta"
                    android:textColor="#757575"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- ── LOADING ───────────────────────────────────────── -->
            <ProgressBar
                android:id="@+id/progressBarHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:indeterminateTint="#2E7D32"
                android:visibility="visible"/>

            <!-- ── LISTA DE PLANTAS ──────────────────────────────── -->
            <!--
                Usar RecyclerView dentro de NestedScrollView requer
                android:nestedScrollingEnabled="false" para o scroll
                funcionar de forma integrada.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPlantasHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="4dp"
                android:paddingBottom="100dp"
                android:clipToPadding="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════════════════════════
         FAB — Adicionar nova planta
    ═══════════════════════════════════════════════════════════ -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdicionarPlanta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Adicionar planta"
        app:backgroundTint="#2E7D32"
        app:tint="#FFFFFF"
        app:fabSize="normal"
        app:elevation="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>