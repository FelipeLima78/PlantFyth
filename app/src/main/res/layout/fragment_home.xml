<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F2"
    tools:context=".ui.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- TITULO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PlantFyth"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitoramento diário"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="14dp"/>

            <!-- CARD PRINCIPAL -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- TITULO -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plantas de Hoje"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#1B5E20"
                        android:layout_marginBottom="12dp"/>

                    <!-- PLANTA -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Samambaia da Sala"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#212121"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Samambaia"
                            android:textSize="12sp"
                            android:textColor="#757575"
                            android:layout_marginBottom="6dp"/>

                        <!-- LINHA INFO -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="78%"
                                android:textStyle="bold"
                                android:textColor="#2E7D32"
                                android:textSize="15sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" • Adubo 4d"
                                android:textSize="13sp"
                                android:textColor="#616161"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" • Poda 12d"
                                android:textSize="13sp"
                                android:textColor="#616161"/>

                            <!-- TOGGLE -->

                            <Button
                                android:id="@+id/btnIrrigacao1"
                                android:layout_width="90dp"
                                android:layout_height="38dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_toggle_nao"
                                android:backgroundTint="#3F389523"
                                android:text="NO"
                                android:textColor="#FFFFFF"
                                android:textColorLink="#A93D3D"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- DIVISOR -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="10dp"/>

                    <!-- PLANTA 2 -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Costela de Adão"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#212121"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monstera Deliciosa"
                            android:textSize="12sp"
                            android:textColor="#757575"
                            android:layout_marginBottom="6dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="52%"
                                android:textStyle="bold"
                                android:textColor="#E65100"
                                android:textSize="15sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" • Adubo 2d"
                                android:textSize="13sp"
                                android:textColor="#616161"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" • Poda 8d"
                                android:textSize="13sp"
                                android:textColor="#616161"/>

                            <Button
                                android:id="@+id/btnIrrigacao2"
                                android:layout_width="90dp"
                                android:layout_height="38dp"
                                android:layout_marginStart="10dp"
                                android:text="NO"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- BOTAO SALVAR -->

                    <Button
                        android:id="@+id/btnSalvar"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#4CAF50"
                        android:text="Salvar Alterações"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- AVISOS -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="90dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                android:backgroundTint="#FFF8E1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avisos"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#E65100"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Algumas plantas estão abaixo da umidade ideal."
                        android:textSize="14sp"
                        android:textColor="#5D4037"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FAB -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdicionarPlanta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="18dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#4CAF50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>