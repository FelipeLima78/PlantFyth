<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/fundo_dialog">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ATENÇÃO!!!"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:gravity="center"
        android:layout_marginBottom="60dp"/>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <TextView
            android:id="@+id/textoTermos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="As informações de manejo do Plantfyth são recomendações com fontes acadêmicas de regiões diferentes, entenda que são recomendações do que seria mais próximo do ideal para o seu plantio. Os valores deirrigação, exposição a luz e adubação podem variar de acordo com a região que você cultiva seu plantio."
            android:textColor="#555555"
            android:textSize="16sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnContinuar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2E7D32"
        android:text="Prosseguir" />

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:src="@drawable/logo"
        android:layout_marginBottom="12dp"/>

</LinearLayout>