<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F2"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVoltarEspecies"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_species_icon"
                android:contentDescription="Voltar para espécies"
                android:padding="7dp"
                android:src="@drawable/ic_species_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Espécies"
                android:textColor="#347443"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription=""
                android:src="@drawable/ic_species_leaf" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="plantFyth"
                android:textColor="#315F3A"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="PAINEL ADMINISTRATIVO"
            android:textColor="#6E8970"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTituloForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nova espécie"
            android:textColor="#214F2A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Preencha os dados e os cuidados da planta."
            android:textColor="#6B7A6B"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="Campos com * são obrigatórios."
            android:textColor="#849486"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/progressForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutCampos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_species_icon"
                            android:contentDescription=""
                            android:padding="9dp"
                            android:src="@drawable/ic_species_leaf" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Identificação"
                                android:textColor="#285D35"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Conheça a espécie pelo nome."
                                android:textColor="#849486"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:background="#E7EEE5" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Nome popular *" />

                    <EditText
                        android:id="@+id/edtNomePopular"
                        style="@style/SpeciesEditField"
                        android:layout_height="46dp"
                        android:hint="Digite o nome popular"
                        android:inputType="textCapSentences" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Nome científico *" />
                    <EditText
                        android:id="@+id/edtNomeCientifico"
                        style="@style/SpeciesEditField"
                        android:layout_height="46dp"
                        android:hint="Digite o nome científico"
                        android:inputType="textCapSentences" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Família botânica" />
                    <EditText
                        android:id="@+id/edtFamilia"
                        style="@style/SpeciesEditField"
                        android:layout_height="46dp"
                        android:hint="Digite a família botânica"
                        android:inputType="textCapSentences" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Ciclo da planta" />
                    <EditText
                        android:id="@+id/edtCiclo"
                        style="@style/SpeciesEditField"
                        android:layout_height="46dp"
                        android:hint="Informe o ciclo da planta"
                        android:inputType="textCapSentences" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Velocidade de crescimento" />
                    <Spinner
                        android:id="@+id/spnCrescimento"
                        style="@style/SpeciesSpinnerField"
                        android:contentDescription="Velocidade de crescimento" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Tamanho adulto" />
                    <EditText
                        android:id="@+id/edtTamanhoAdulto"
                        style="@style/SpeciesEditField"
                        android:layout_height="46dp"
                        android:hint="Informe o tamanho (cm)"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_species_icon"
                            android:contentDescription=""
                            android:padding="9dp"
                            android:src="@drawable/ic_species_care" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cuidados"
                                android:textColor="#285D35"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Uma rotina para cultivar melhor."
                                android:textColor="#849486"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_species_tip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription=""
                            android:src="@drawable/ic_species_info" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:layout_weight="1"
                            android:text="Digite só o número e escolha a unidade ao lado. “Sazonal” e “Não precisa” dispensam o número."
                            android:textColor="#54715A"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView style="@style/SpeciesSubsection" android:text="●  IRRIGAÇÃO" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Intervalo de irrigação *" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edtPeriodoIrrigacao"
                            style="@style/SpeciesEditField"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1.1"
                            android:hint="Ex.: 7"
                            android:inputType="number"
                            android:maxLength="4"
                            android:maxLines="1" />

                        <Spinner
                            android:id="@+id/spnUnidadeIrrigacao"
                            style="@style/SpeciesSpinnerField"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="0.9" />
                    </LinearLayout>

                    <TextView style="@style/SpeciesFieldLabel" android:text="Volume de irrigação *" />
                    <Spinner
                        android:id="@+id/spnVolumeIrrigacao"
                        style="@style/SpeciesSpinnerField"
                        android:contentDescription="Volume de irrigação" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#E7EEE5" />

                    <TextView style="@style/SpeciesSubsection" android:text="✂  MANUTENÇÃO" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Intervalo de adubação" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edtAdubacao"
                            style="@style/SpeciesEditField"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1.1"
                            android:hint="Ex.: 1"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="1" />

                        <Spinner
                            android:id="@+id/spnUnidadeAdubacao"
                            style="@style/SpeciesSpinnerField"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="0.9" />
                    </LinearLayout>

                    <TextView style="@style/SpeciesFieldLabel" android:text="Intervalo de poda" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edtPeriodoPoda"
                            style="@style/SpeciesEditField"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1.1"
                            android:hint="Ex.: 2"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="1" />

                        <Spinner
                            android:id="@+id/spnUnidadePoda"
                            style="@style/SpeciesSpinnerField"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="0.9" />
                    </LinearLayout>

                    <TextView style="@style/SpeciesFieldLabel" android:text="Intervalo para troca de vaso" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edtTrocaVaso"
                            style="@style/SpeciesEditField"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1.1"
                            android:hint="Ex.: 2"
                            android:inputType="number"
                            android:maxLines="1" />

                        <Spinner
                            android:id="@+id/spnUnidadeVaso"
                            style="@style/SpeciesSpinnerField"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="0.9" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#E7EEE5" />

                    <TextView style="@style/SpeciesSubsection" android:text="☀  LUZ E TEMPERATURA" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Exposição à luz *" />
                    <Spinner
                        android:id="@+id/spnLuz"
                        style="@style/SpeciesSpinnerField"
                        android:contentDescription="Exposição à luz" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Temperatura recomendada" />
                    <EditText
                        android:id="@+id/edtTemperatura"
                        style="@style/SpeciesEditField"
                        android:hint="Informe a temperatura"
                        android:inputType="textCapSentences" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#E7EEE5" />

                    <TextView style="@style/SpeciesFieldLabel" android:text="Descrição da espécie e orientação de rega" />

                    <EditText
                        android:id="@+id/edtDescricao"
                        style="@style/SpeciesDescriptionField"
                        android:layout_height="174dp"
                        android:hint="Descreva a espécie e como realizar a rega..." />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Inclua características e recomendações que ajudem no cuidado diário."
                        android:textColor="#849486"
                        android:textSize="10sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvarEspecime"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:elevation="3dp"
            android:text="✓  Salvar espécie"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#2E8039"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarEspecime"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#416B48"
            android:textSize="14sp"
            app:backgroundTint="#F4F8F2"
            app:cornerRadius="24dp"
            app:strokeColor="#DCE6DB"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
