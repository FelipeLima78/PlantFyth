<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTituloForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nova espécie"
            android:textColor="#1B5E20"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Preencha os dados e os cuidados da planta. Campos com * são obrigatórios."
            android:textColor="#6B7A6B"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:id="@+id/layoutCampos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Identificação -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Identificação"
                    android:textColor="#1B5E20"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNomePopular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome popular *"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/edtNomeCientifico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome científico *"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/edtFamilia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Família botânica"
                    android:inputType="textCapSentences" />

                <EditText
                    android:id="@+id/edtCiclo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ciclo da planta"
                    android:inputType="textCapSentences" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Velocidade de crescimento"
                    android:textColor="#374737"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spnCrescimento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Velocidade de crescimento" />

                <EditText
                    android:id="@+id/edtTamanhoAdulto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tamanho adulto em cm"
                    android:inputType="numberDecimal" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E0E7DF" />

                <!-- Cuidados -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cuidados"
                    android:textColor="#1B5E20"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Digite só o número e escolha a unidade ao lado. “Sazonal” e “Não precisa” dispensam o número."
                    android:textColor="#6B7A6B"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Intervalo de irrigação *"
                    android:textColor="#374737"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtPeriodoIrrigacao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:hint="Ex.: 7"
                        android:inputType="number"
                        android:maxLength="4"
                        android:maxLines="1" />

                    <Spinner
                        android:id="@+id/spnUnidadeIrrigacao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Volume de irrigação *"
                    android:textColor="#374737"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spnVolumeIrrigacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Volume de irrigação" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Intervalo de adubação"
                    android:textColor="#374737"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtAdubacao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Ex.: 1"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1" />

                    <Spinner
                        android:id="@+id/spnUnidadeAdubacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Intervalo de poda"
                    android:textColor="#374737"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtPeriodoPoda"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Ex.: 2"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1" />

                    <Spinner
                        android:id="@+id/spnUnidadePoda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Intervalo para troca de vaso"
                    android:textColor="#374737"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtTrocaVaso"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Ex.: 2"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1" />

                    <Spinner
                        android:id="@+id/spnUnidadeVaso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Exposição à luz *"
                    android:textColor="#374737"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spnLuz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Exposição à luz" />

                <EditText
                    android:id="@+id/edtTemperatura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Temperatura recomendada"
                    android:inputType="textCapSentences" />

                <!-- Descrição no final -->

                <EditText
                    android:id="@+id/edtDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="top"
                    android:hint="Descrição da espécie e orientação de rega"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="3" />

                <Button
                    android:id="@+id/btnSalvarEspecime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#2E7D32"
                    android:text="Salvar espécie"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnCancelarEspecime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancelar"
                    android:textAllCaps="false" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>